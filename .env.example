# Contraseña del usuario sa de SQL Server (mínimo 8 caracteres con mayúscula, minúscula, número y símbolo).
MSSQL_SA_PASSWORD=CAMBIAR_ESTO

# Cadena de conexión que usa la aplicación; debe contener el mismo valor de contraseña que MSSQL_SA_PASSWORD.
ConnectionStrings__Default=Server=localhost,1433;Database=CAMBIAR_ESTO;User Id=sa;Password=CAMBIAR_ESTO;TrustServerCertificate=True

# Servidor SMTP.
SMTP_HOST=smtp.gmail.com
# Puerto SMTP.
SMTP_PUERTO=587
# Usuario SMTP.
SMTP_USUARIO=CAMBIAR_ESTO
# Clave SMTP.
SMTP_CLAVE=CAMBIAR_ESTO
# Dirección del remitente.
SMTP_REMITENTE=CAMBIAR_ESTO
# Nombre visible del remitente.
SMTP_NOMBRE_REMITENTE=Gestor de Tareas
