# Contraseña del usuario sa de SQL Server.
MSSQL_SA_PASSWORD=Ejemplo_Clave_123

# Cadena de conexión local de la aplicación.
ConnectionStrings__Default=Server=localhost,1433;Database=GestorTareas;User Id=sa;Password=Ejemplo_Clave_123;TrustServerCertificate=True

# Servidor SMTP que enviará los correos.
SMTP_HOST=smtp.gmail.com

# Puerto del servidor SMTP.
SMTP_PUERTO=587

# Usuario para autenticarse en el servidor SMTP.
SMTP_USUARIO=usuario@example.com

# Clave para autenticarse en el servidor SMTP.
SMTP_CLAVE=clave_de_ejemplo

# Dirección de correo del remitente.
SMTP_REMITENTE=usuario@example.com

# Nombre visible del remitente.
SMTP_NOMBRE_REMITENTE=Gestor de Tareas

# URL base para generar los enlaces de activación.
APP_URL_BASE=http://localhost:5065

# Nombre del Administrador inicial.
ADMIN_NOMBRE=Administrador de ejemplo

# Correo del Administrador inicial.
ADMIN_CORREO=admin.ejemplo@example.com

# Clave del Administrador inicial.
ADMIN_CLAVE=Cambiar_Esta_Clave_123

# Clave de acceso a WeatherAPI.
CLIMA_API_KEY=clave_de_ejemplo
